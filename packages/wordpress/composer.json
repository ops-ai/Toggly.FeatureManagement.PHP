{
    "name": "toggly/wordpress",
    "version": "0.4.1",
    "description": "Toggly Feature Management WordPress plugin integration",
    "type": "library",
    "keywords": [
        "toggly",
        "feature-flags",
        "feature-management",
        "wordpress"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Toggly",
            "email": "support@toggly.io",
            "homepage": "https://toggly.io",
            "role": "Developer"
        }
    ],
    "homepage": "https://docs.toggly.io/sdks/php",
    "support": {
        "issues": "https://github.com/ops-ai/Toggly.FeatureManagement.PHP/issues",
        "source": "https://github.com/ops-ai/Toggly.FeatureManagement.PHP",
        "docs": "https://docs.toggly.io/sdks/php"
    },
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3|^8.4",
        "toggly/feature-management-php": "^0.4.1"
    },
    "autoload": {
        "psr-4": {
            "Toggly\\WordPress\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
