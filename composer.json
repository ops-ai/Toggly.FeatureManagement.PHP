{
    "name": "toggly/feature-management-php-monorepo",
    "description": "Dev workspace for Toggly PHP SDK packages (not published to Packagist)",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require": {
        "toggly/feature-management-php": "0.4.1",
        "toggly/laravel": "0.4.1",
        "toggly/wordpress": "0.4.1"
    },
    "require-dev": {
        "google/protobuf": "^3.25|^4.0",
        "illuminate/cache": "^11.47",
        "illuminate/contracts": "^11.0",
        "mongodb/mongodb": "^2.0",
        "phpunit/phpunit": "^9.0|^10.0",
        "textalk/websocket": "^1.6"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Toggly\\FeatureManagement\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
