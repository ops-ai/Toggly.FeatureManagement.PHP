<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         colors="true"
         resolveDependencies="true">
    <testsuites>
        <!-- Single suite: a nested Unit suite under tests/ would re-run Unit
             tests and break Sonar PHPUnit report import (duplicate measures). -->
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
            <directory suffix=".php">packages/laravel/src</directory>
            <directory suffix=".php">packages/wordpress/src</directory>
        </include>
    </source>
    <php>
        <env name="MONGO_TEST_URI" value="mongodb://localhost:27017"/>
    </php>
</phpunit>
